{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://url-shortner-backend-qoag.onrender.com/api/$1"
    },
    {
      "source": "/auth(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!auth|dashboard|api).*)",
      "destination": "https://url-shortner-backend-qoag.onrender.com/$1"
    }
  ]
}