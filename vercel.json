{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://url-shortner-backend-2l6c.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:id",
      "destination": "https://url-shortner-backend-2l6c.onrender.com/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]