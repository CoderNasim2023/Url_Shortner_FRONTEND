{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://urlify-backend-sfgu.onrender.com//api/:path*"
    },
    {
      "source": "/:id([a-zA-Z0-9]{5,10})",
      "destination": "https://urlify-backend-sfgu.onrender.com/:id"
    }
  ],
  "routes": [
    {
      "src": "/auth(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/dashboard(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}